PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/Smartlab
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ORIGINS=http://localhost:5173,https://smartlab2-frontend.vercel.app

# First-run bootstrap only. Remove this value after the first administrator exists.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_NAME=Laboratory Administrator
ADMIN_INITIAL_PASSWORD=
SEED_DEMO_DATA=false

LAB_NAME=Smart Lab Diagnostic Centre
LAB_ADDRESS=

# Optional: configured SMTP enables actual approved-report email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional local gateway shared secret: use a unique random value of 32+ characters.
MACHINE_GATEWAY_TOKEN=
